# Files we don't want in the build context (faster + smaller image).
.git
.gitignore
.env
.env.local
.env.*.local
.next
build
node_modules
# Every nested node_modules too (a bare "node_modules" only matches the top level).
**/node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
*.log
coverage
.vscode
.idea
DOCS
README*.md
*.md
docker-compose*.yml
Dockerfile
.dockerignore

# Dev / test scripts — kept in the repo for local use, never shipped in the
# production image (which copies all of prisma/ and docker/). Several send
# REAL WhatsApp messages or write fixture data.
prisma/test_*.ts
prisma/smoke_*.ts
prisma/trigger_*.ts
prisma/verify_*.ts
prisma/seed_dummy_*.ts
prisma/seed_poll_demo.ts
prisma/audit_features.ts
prisma/check_poll_readiness.ts
prisma/migrate_templates_to_poll.ts
docker/labstack-dummy
.scratch
.scratch-*.ts

# Other services and local artefacts: built from their own folders (see
# docker-compose*.yml), never part of the app image. The gateway's WhatsApp
# session, media and node_modules alone made the context gigabytes.
whatsapp-bot
whisper-service
mockups
.sim
*.xlsx
*.dump
*.sql.gz
