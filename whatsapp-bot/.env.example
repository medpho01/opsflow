# LabStack replica (read-only) — same DB OpsFlow reads. Required for status
# lookups; without it the bot still classifies but can't fetch order status.
SOURCE_DATABASE_URL=postgresql://labstack:PASSWORD@10.17.0.36:5432/dhanavantri

# Safety switch. TRUE (default) = observe & log only, never send.
# Only set to "false" once the dry-run log looks correct AND you're on a
# dedicated number (not a personal one).
DRY_RUN=true

# Where the structured dry-run log is written (JSON lines).
LOG_FILE=./dry-run.log.jsonl
